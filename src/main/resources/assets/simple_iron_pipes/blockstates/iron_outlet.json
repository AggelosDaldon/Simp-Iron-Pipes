{
  "multipart": [
    {
      "when": {
        "north": "false",
        "south": "false",
        "east": "false",
        "west": "false",
        "up": "false",
        "down": "false"
      },
      "apply": {
        "model": "simple_iron_pipes:block/iron_pipe_segment"
      }
    },
    {
      "when": {
        "OR": [
          {
            "north": "true"
          },
          {
            "south": "true"
          },
          {
            "east": "true"
          },
          {
            "west": "true"
          },
          {
            "up": "true"
          },
          {
            "down": "true"
          }
        ]
      },
      "apply": {
        "model": "simple_iron_pipes:block/iron_fitting_center"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "simple_iron_pipes:block/iron_pipe_segment"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "simple_iron_pipes:block/iron_pipe_segment",
        "y": 180
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "simple_iron_pipes:block/iron_pipe_segment",
        "y": 90
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "simple_iron_pipes:block/iron_pipe_segment",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "simple_iron_pipes:block/iron_pipe_segment",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "simple_iron_pipes:block/iron_pipe_segment",
        "x": 90
      }
    }
  ]
}